# ==============================================================================
# ShipU Logistics - Root Environment Variables Example
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PORT=5000
HOSTNAME="localhost"
LOG_LEVEL="trace"

# Database connection URL (Prisma/PostgreSQL)
DATABASE_URL="postgresql://admin:admin123@localhost:5432/mydb?schema=public"

# Redis Cache connection
REDIS_URL="redis://localhost:6379"

# RabbitMQ Message Broker connection
RABBITMQ_URL="amqp://localhost:5672"

# ----------------------------------------------------------------------------
# Docker credentials
# ----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# RabbitMQ
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Active logging level for the browser console (trace | debug | info | warn | error | fatal)
VITE_LOG_LEVEL="trace"
