{
    "name": "shipu-logistics",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "prettier": "^3.7.4",
        "turbo": "^2.10.5",
        "typescript": "5.9.2",
        "typescript-eslint": "^8.65.0"
    },
    "engines": {
        "node": ">=18"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14"
        }
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
