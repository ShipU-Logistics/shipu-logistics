{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "PORT",
        "RABBITMQ_URL",
        "REDIS_URL",
        "LOG_LEVEL",
        "HOSTNAME"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
